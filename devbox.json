{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": [
    "ansible-doctor@8.4.0",
    "ansible-lint@25.8.2",
    "git@2.55.0",
    "go-task@3.52.0",
    "podman@5.8.6",
    "prek@0.4.14",
    "python313Packages.ansible@14.3.1",
    "python313Packages.molecule@26.6.0",
    "python313Packages.molecule-plugins@25.8.12",
    "python313Packages.pytest@9.1.1",
    "python313Packages.pytest-ansible@26.6.0",
    "python313Packages.ruff@0.16.4",
    "yamllint@1.37.1"
  ],
  "env": {
      "DEVBOX_VIRTUAL_ENV": "${DEVBOX_PROJECT_ROOT}/.devbox/virtenv"
  },
  "shell": {
    "init_hook": [
      "export ANSIBLE_GALAXY_COLLECTIONS_PATH=${DEVBOX_VIRTUAL_ENV}/ansible/collections;",
      "export ANSIBLE_COLLECTION_ROLES_PATH=${DEVBOX_PROJECT_ROOT}/roles;",
      "export ANSIBLE_ROLES_PATH=${ANSIBLE_GALAXY_ROLES_PATH}:${ANSIBLE_COLLECTION_ROLES_PATH};",
      "task prepare"
    ]
  }
}
